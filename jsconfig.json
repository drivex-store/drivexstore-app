{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@root/*": [
        "./*"
      ],
      "env": [
        "./env.mjs"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@providers/*": [
        "./src/providers/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@libs/*": [
        "./src/libs/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@animations/*": [
        "./src/features/animations/*"
      ],
      "@views/*": [
        "./src/views/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "sanity.config.js",
    "next.config.mjs",
    "env.mjs"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "__MACOSX",
    "public"
  ]
}
